# OIDC realm "rauthy" — the fleet IdP as a Proxmox VE authentication realm.
#
# Declared facts only; the client secret is NEVER stored here (canonical
# copy lives in Rauthy itself, regenerable via the admin API — rotation =
# regenerate there, re-run lib/apply-oidc-realm.sh with the new value in
# OIDC_CLIENT_KEY). Consumed by lib/apply-oidc-realm.sh, which is
# idempotent and re-runnable — including after a node is rebuilt onto
# proxmox-nixos, because the realm lives in pmxcfs (state), not in the
# host's nix configuration.
#
# The matching Rauthy client ("proxmox"): confidential, RS256 tokens,
# challenges = S256 — PVE 9's rust OIDC sends PKCE (live-verified via the
# apply script's authorize-hop check), so the client ENFORCES it.
# Redirect URI = the EXACT browser origin of the web UI; every hostname
# the UI is reached at must be registered as its own redirect URI.

REALM="rauthy"
# MUST byte-match the `issuer` value in the IdP's discovery document —
# Rauthy advertises it WITH the trailing slash, and PVE's rust OIDC
# rejects any mismatch at the authorize step (live-verified 2026-07-05).
ISSUER_URL="https://auth.v99n62.ai/auth/v1/"
CLIENT_ID="proxmox"
# Stable, human-readable usernames: <email>@rauthy. Immutable after realm
# creation (PVE fixes username-claim at add time).
USERNAME_CLAIM="email"
AUTOCREATE=1
# PVE has no RP-initiated logout (its logout only drops the local ticket),
# so the fleet's single sign-out round-trip cannot hold via the logout leg.
# prompt=login closes the harmful half from the other side: EVERY Proxmox
# login forces re-authentication at Rauthy — silent re-entry through a
# still-live SSO session is impossible. Documented exception in
# infra-auth runbooks/relying-party-checklist.md.
PROMPT="login"
SCOPES="openid email profile"
# Admin identities are passed at apply time, like the client secret:
#   OIDC_CLIENT_KEY=<secret> OIDC_ADMIN_USERS="<account> ..." \
#     lib/apply-oidc-realm.sh proxmox/oidc-<realm>.env root@<node>
# Each account gets Administrator on / via a per-user ACL; switch to
# groups-claim once more than a couple of operators exist.
